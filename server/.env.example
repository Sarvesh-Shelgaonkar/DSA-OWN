# Copy to .env and fill in real values. NEVER commit the real .env.

# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/mydsa?retryWrites=true&w=majority

# Long random secret used to sign auth tokens (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Google Sign-In (optional). The SAME OAuth 2.0 Client ID used by the frontend
# (VITE_GOOGLE_CLIENT_ID). The server uses it to verify Google ID tokens.
# Leave empty to disable Google Sign-In.
GOOGLE_CLIENT_ID=

# Google Gemini API key for the AI Resume Interview Coach (/interview).
# Get a FREE key at https://aistudio.google.com/app/apikey
# Leave empty to disable AI analysis — the app falls back to the static question banks.
GEMINI_API_KEY=
# Optional: override the model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
