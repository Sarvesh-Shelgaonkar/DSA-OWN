# Frontend environment. Copy to .env for local dev if needed.

# API base URL. Leave unset in development (Vite proxies /api to localhost:4000).
# In production, set to your deployed API, e.g. https://mydsa-api.onrender.com/api
# VITE_API_URL=https://your-api-host.onrender.com/api

# Google Sign-In (optional). Create an OAuth 2.0 Client ID (type: Web application)
# at https://console.cloud.google.com/apis/credentials and paste the Client ID here.
# Add your site origins (e.g. http://localhost:5173, http://localhost:5174, and your
# production URL) under "Authorized JavaScript origins". If unset, the "Sign in with
# Google" button is hidden and email/password sign-in still works.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
