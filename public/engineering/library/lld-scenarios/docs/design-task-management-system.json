          "exchanges": []
        },
        {
          "type": "paragraph",
          "text": "It passed through apps, banks, switches, networks, servers, logs, and humans and returned certainty in less than a second.",
          "items": [],
          "leftItems": [],
          "rightItems": [],
          "cards": [],
          "metrics": [],
          "points": [],
          "layers": [],
          "exchanges": []
        },
        {
          "type": "paragraph",
          "text": "UPI did not just solve payments.",
          "items": [],
          "leftItems": [],
          "rightItems": [],
          "cards": [],
          "metrics": [],
          "points": [],
          "layers": [],
          "exchanges": []
        },
        {
