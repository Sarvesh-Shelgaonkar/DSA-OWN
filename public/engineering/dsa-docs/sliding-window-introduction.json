{
  "slug": "sliding-window-introduction",
  "title": "Introduction to Sliding Window",
  "description": "Learn how sliding window avoids repeated work by reusing previous computations",
  "patternId": "696a41fe9f270f2334e45840",
  "isPremium": true,
  "order": 0,
