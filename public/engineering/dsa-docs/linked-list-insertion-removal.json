{
  "slug": "linked-list-insertion-removal",
  "title": "Linked List Insertion & Removal",
  "description": "",
  "patternId": "696a434d9f270f2334e45896",
  "isPremium": true,
  "order": 0,
  "sections": [
    {
      "id": "introduction",
