class Solution {
public:

    int digitSum(int num)
    {
        int sum = 0;

        while(num > 0)
        {
            sum += num % 10;
            num /= 10;
        }

        return sum;
    }

    vector<int> convertarray(vector<int>& nums)
    {
        int n = nums.size();

        for(int i = 0; i < n; i++)
        {
            nums[i] = digitSum(nums[i]);
        }

        return nums;
    }

    int minElement(vector<int>& nums) 
    {
        int mini = INT_MAX;

        nums = convertarray(nums);

        for(auto &i : nums)
        {
            mini = min(mini, i);
        }

        return mini;
    }
};



Aur Simple (Without Extra Array)
We only need minimum we dont need to change the entire array->

class Solution {
public:
    int minElement(vector<int>& nums) {
        
        int ans = INT_MAX;

        for(int num : nums)
        {
            int sum = 0;

            while(num > 0)
            {
                sum += num % 10;
                num /= 10;
            }

            ans = min(ans, sum);
        }

        return ans;
    }
};

